%YAML 1.2
---
name: JavaScript
file_extensions:
  - js
  - mjs
  - cjs
  - jsx
first_line_match: '^#!.*\b(node|deno|bun|js)\b'
scope: source.js

contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.js
    - match: '/\*'
      scope: punctuation.definition.comment.js
      push: block_comment
    - match: '\b(function)\s+([a-zA-Z_$][a-zA-Z0-9_$]*)'
      captures:
        1: storage.type.js
        2: entity.name.function.js
    - match: '\b(async|await|break|case|catch|continue|default|do|else|export|finally|for|from|if|import|return|switch|throw|try|while|yield)\b'
      scope: keyword.control.js
    - match: '\b(class|const|extends|function|get|let|new|set|static|typeof|var|void|delete|in|instanceof|of)\b'
      scope: storage.type.js
    - match: '\b(true|false|null|undefined|NaN|Infinity|this|super|console|window|document|Math|JSON|Promise)\b'
      scope: constant.language.js
    - match: '\b0x[0-9a-fA-F_]+|\b[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?n?\b'
      scope: constant.numeric.js
    - match: '"'
      scope: punctuation.definition.string.begin.js
      push: double_string
    - match: ''''
      scope: punctuation.definition.string.begin.js
      push: single_string
    - match: '`'
      scope: punctuation.definition.string.begin.js
      push: template_string

  block_comment:
    - meta_scope: comment.block.js
    - match: '\*/'
      scope: punctuation.definition.comment.js
      pop: true

  double_string:
    - meta_scope: string.quoted.double.js
    - match: '\\.'
      scope: constant.character.escape.js
    - match: '"'
      scope: punctuation.definition.string.end.js
      pop: true

  single_string:
    - meta_scope: string.quoted.single.js
    - match: '\\.'
      scope: constant.character.escape.js
    - match: ''''
      scope: punctuation.definition.string.end.js
      pop: true

  template_string:
    - meta_scope: string.quoted.other.template.js
    - match: '\\.'
      scope: constant.character.escape.js
    - match: '`'
      scope: punctuation.definition.string.end.js
      pop: true
